NODE_ENV=development
PORT=4050
API_PREFIX=/api/v1
# Varias URLs separadas por coma (en producción, la URL de Vercel)
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
TIMEZONE=America/Mexico_City
# 1 en Render (la API está detrás de un proxy)
TRUST_PROXY=0
# Límite de intentos de login y de emisión de turnos (por defecto solo en producción)
RATE_LIMIT_ENABLED=false

#firebase
FIREBASE_PROJECT_ID=fila-cero-p6
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

#auth (JWT)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
